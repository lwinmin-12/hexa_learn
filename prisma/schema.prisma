// Hexa Learn - Prisma schema (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

// ───────────── ENUMS ─────────────

enum AuthProvider {
  password
  google
  apple
  facebook
}

enum UserRole {
  super_admin
  page_admin
  learner
}

enum UserStatus {
  active
  suspended
}

enum ContentStatus {
  draft
  scheduled
  published
}

enum UploadStatus {
  pending
  uploading
  ready
  failed
}

enum AudioType {
  vocab
  speaking
}

enum AccessType {
  free
  paid
}

enum EnrollmentStatus {
  active
  completed
}

enum PaymentMethodType {
  qr
  bank_transfer
}

enum DiscountType {
  percent
  fixed
}

enum PaymentStatus {
  pending
  slip_uploaded
  approved
  rejected
}

// ───────────── AUTH ─────────────

model User {
  id              String       @id @default(uuid()) @db.Uuid
  firebaseUid     String       @unique @map("firebase_uid")
  provider        AuthProvider
  email           String?
  displayName     String?      @map("display_name")
  avatarUrl       String?      @map("avatar_url")
  phone           String?      @unique
  phoneVerifiedAt DateTime?    @map("phone_verified_at")
  role            UserRole     @default(learner)
  status          UserStatus   @default(active)
  createdAt       DateTime     @default(now()) @map("created_at")
  deletedAt       DateTime?    @map("deleted_at")
  firebaseDeletedAt DateTime?  @map("firebase_deleted_at")

  phoneVerification PhoneVerification?
  deviceTokens     DeviceToken[]
  ownedCourses     Course[]
  enrollments      Enrollment[]
  episodeProgress  EpisodeProgress[]
  quizAttempts     QuizAttempt[]
  payments         Payment[]         @relation("PaymentUser")
  reviewedPayments Payment[]         @relation("PaymentReviewer")
  channelMembers   ChannelMember[]
  sentMessages     ChannelMessage[]
  notifications    Notification[]
  certificates     Certificate[]

  @@map("users")
}

model PhoneVerification {
  userId      String   @id @map("user_id") @db.Uuid
  id          String   @unique @default(uuid()) @db.Uuid
  phone       String
  sessionInfo String?  @map("session_info")
  attempts    Int      @default(0)
  lastSentAt  DateTime @map("last_sent_at")
  expiresAt   DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("phone_verifications")
}

model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  fcmToken  String   @unique @map("fcm_token")
  platform  String   // ios | android | web
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

// ───────────── CONTENT ─────────────

model Course {
  id          String        @id @default(uuid()) @db.Uuid
  ownerId     String        @map("owner_id") @db.Uuid
  title       String
  slug        String        @unique
  description String?
  coverUrl    String?       @map("cover_url")
  isPremium   Boolean       @default(false) @map("is_premium")
  price       Decimal?      @db.Decimal(12, 2)
  currency    String?       @db.VarChar(3)
  status      ContentStatus @default(draft)
  publishAt   DateTime?     @map("publish_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  owner        User          @relation(fields: [ownerId], references: [id])
  chapters     Chapter[]
  quizzes      Quiz[]
  enrollments  Enrollment[]
  payments     Payment[]
  promoCodes   PromoCode[]
  channel      Channel?
  certificates Certificate[]

  @@index([ownerId])
  @@index([status, publishAt])
  @@map("courses")
}

model Chapter {
  id       String        @id @default(uuid()) @db.Uuid
  courseId String        @map("course_id") @db.Uuid
  title    String
  position Int
  status   ContentStatus @default(draft)

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  episodes    Episode[]
  flashcards  Flashcard[]
  audioTracks AudioTrack[]
  quizzes     Quiz[]

  @@unique([courseId, position])
  @@map("chapters")
}

model Episode {
  id          String        @id @default(uuid()) @db.Uuid
  chapterId   String        @map("chapter_id") @db.Uuid
  title       String
  description String?
  position    Int
  status      ContentStatus @default(draft)
  publishAt   DateTime?     @map("publish_at")

  // video fields (merged from the old Video model)
  videoUrl          String?      @map("video_url")
  videoDurationSec  Int?         @map("video_duration_sec")
  videoUploadStatus UploadStatus @default(pending) @map("video_upload_status")
  videoScheduledAt  DateTime?    @map("video_scheduled_at")

  chapter  Chapter           @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  quizzes  Quiz[]
  progress EpisodeProgress[]

  @@unique([chapterId, position])
  @@map("episodes")
}


// ───────────── LEARNING TOOLS ─────────────

model Flashcard {
  id        String  @id @default(uuid()) @db.Uuid
  chapterId String  @map("chapter_id") @db.Uuid
  frontText String  @map("front_text")
  backText  String  @map("back_text")
  audioUrl  String? @map("audio_url")
  position  Int

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId, position])
  @@map("flashcards")
}

model AudioTrack {
  id          String    @id @default(uuid()) @db.Uuid
  chapterId   String    @map("chapter_id") @db.Uuid
  type        AudioType
  title       String
  audioUrl    String    @map("audio_url")
  durationSec Int?      @map("duration_sec")
  position    Int

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId, type, position])
  @@map("audio_tracks")
}

// ───────────── QUIZ ─────────────

// Exactly one of courseId / chapterId / episodeId must be set.
// Prisma can't express CHECK constraints, so add it in a migration (see notes at the bottom).
model Quiz {
  id           String  @id @default(uuid()) @db.Uuid
  title        String
  createdAt    DateTime @default(now()) @map("created_at")
  passScore    Int     @map("pass_score")
  timeLimitSec Int?    @map("time_limit_sec")
  courseId     String? @map("course_id") @db.Uuid
  chapterId    String? @map("chapter_id") @db.Uuid
  episodeId    String? @map("episode_id") @db.Uuid

  course    Course?        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapter   Chapter?       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  episode   Episode?       @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([courseId])
  @@index([chapterId])
  @@index([episodeId])
  @@map("quizzes")
}

model QuizQuestion {
  id           String  @id @default(uuid()) @db.Uuid
  quizId       String  @map("quiz_id") @db.Uuid
  questionText String  @map("question_text")
  position     Int
  points       Int     @default(1)
  explanation  String?

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options QuizOption[]
  answers QuizAnswer[]

  @@index([quizId, position])
  @@map("quiz_questions")
}

model QuizOption {
  id         String  @id @default(uuid()) @db.Uuid
  questionId String  @map("question_id") @db.Uuid
  optionText String  @map("option_text")
  isCorrect  Boolean @default(false) @map("is_correct")
  position   Int

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  QuizAnswer[]

  @@index([questionId, position])
  @@map("quiz_options")
}

model QuizAttempt {
  id          String    @id @default(uuid()) @db.Uuid
  quizId      String    @map("quiz_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  score       Int?
  passed      Boolean?
  startedAt   DateTime  @default(now()) @map("started_at")
  submittedAt DateTime? @map("submitted_at")

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@index([userId, quizId])
  @@map("quiz_attempts")
}

model QuizAnswer {
  id         String  @id @default(uuid()) @db.Uuid
  attemptId  String  @map("attempt_id") @db.Uuid
  questionId String  @map("question_id") @db.Uuid
  optionId   String  @map("option_id") @db.Uuid
  isCorrect  Boolean @map("is_correct")

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option   QuizOption   @relation(fields: [optionId], references: [id], onDelete: Cascade)

  // several rows per question are allowed only for multi-select
  @@unique([attemptId, questionId, optionId])
  @@map("quiz_answers")
}

// ───────────── ENROLLMENT & PROGRESS ─────────────

model Enrollment {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  courseId    String           @map("course_id") @db.Uuid
  accessType  AccessType       @map("access_type")
  status      EnrollmentStatus @default(active)
  progressPct Decimal          @default(0) @map("progress_pct") @db.Decimal(5, 2)
  enrolledAt  DateTime         @default(now()) @map("enrolled_at")
  completedAt DateTime?        @map("completed_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("enrollments")
}

// Chapter and course progress are aggregated from this table.
// The course-level value is cached in Enrollment.progressPct.
model EpisodeProgress {
  userId      String   @map("user_id") @db.Uuid
  episodeId   String   @map("episode_id") @db.Uuid
  watchedSec  Int      @default(0) @map("watched_sec")
  isCompleted Boolean  @default(false) @map("is_completed")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@id([userId, episodeId])
  @@map("episode_progress")
}

// ───────────── PAYMENT ─────────────

model PaymentMethod {
  id          String            @id @default(uuid()) @db.Uuid
  type        PaymentMethodType
  name        String
  accountName String?           @map("account_name")
  accountNo   String?           @map("account_no")
  qrImageUrl  String?           @map("qr_image_url")
  isActive    Boolean           @default(true) @map("is_active")

  payments Payment[]

  @@map("payment_methods")
}

model PromoCode {
  id            String       @id @default(uuid()) @db.Uuid
  code          String       @unique
  discountType  DiscountType @map("discount_type")
  discountValue Decimal      @map("discount_value") @db.Decimal(12, 2)
  courseId      String?      @map("course_id") @db.Uuid // null = any course
  maxUses       Int?         @map("max_uses")
  usedCount     Int          @default(0) @map("used_count")
  validFrom     DateTime?    @map("valid_from")
  validTo       DateTime?    @map("valid_to")
  isActive      Boolean      @default(true) @map("is_active")

  course   Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  payments Payment[]

  @@map("promo_codes")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  courseId        String        @map("course_id") @db.Uuid
  paymentMethodId String        @map("payment_method_id") @db.Uuid
  promoCodeId     String?       @map("promo_code_id") @db.Uuid
  amount          Decimal       @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  finalAmount     Decimal       @map("final_amount") @db.Decimal(12, 2)
  slipUrl         String?       @map("slip_url")
  status          PaymentStatus @default(pending)
  rejectReason    String?       @map("reject_reason")
  reviewedById    String?       @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?     @map("reviewed_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  user          User          @relation("PaymentUser", fields: [userId], references: [id])
  reviewedBy    User?         @relation("PaymentReviewer", fields: [reviewedById], references: [id])
  course        Course        @relation(fields: [courseId], references: [id])
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  promoCode     PromoCode?    @relation(fields: [promoCodeId], references: [id])

  @@index([userId])
  @@index([courseId])
  @@index([status, createdAt])
  @@map("payments")
}

// ───────────── CHANNEL & NOTIFICATIONS ─────────────

model Channel {
  id       String @id @default(uuid()) @db.Uuid
  courseId String @unique @map("course_id") @db.Uuid
  name     String

  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  members  ChannelMember[]
  messages ChannelMessage[]

  @@map("channels")
}

model ChannelMember {
  channelId String   @map("channel_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  joinedAt  DateTime @default(now()) @map("joined_at")
  isMuted   Boolean  @default(false) @map("is_muted")

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@map("channel_members")
}

model ChannelMessage {
  id        String   @id @default(uuid()) @db.Uuid
  channelId String   @map("channel_id") @db.Uuid
  senderId  String   @map("sender_id") @db.Uuid
  title     String
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  channel       Channel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender        User           @relation(fields: [senderId], references: [id])
  notifications Notification[]

  @@index([channelId, createdAt])
  @@map("channel_messages")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  messageId String    @map("message_id") @db.Uuid
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  message ChannelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([userId, readAt])
  @@map("notifications")
}

// ───────────── CERTIFICATE ─────────────

model Certificate {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  courseId      String   @map("course_id") @db.Uuid
  certificateNo String   @unique @map("certificate_no")
  pdfUrl        String?  @map("pdf_url")
  issuedAt      DateTime @default(now()) @map("issued_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("certificates")
}
