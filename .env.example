# App
PORT=3000
NODE_ENV=production
# Used for storage CORS too unless S3_CORS_ORIGINS overrides it.
DASHBOARD_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
JWT_SECRET=change_me

# Postgres
POSTGRES_USER=hexa
POSTGRES_PASSWORD=change_me_strong
POSTGRES_DB=hexa_learn

# Prisma (used when running prisma commands on your host machine)
DATABASE_URL=postgresql://hexa:change_me_strong@localhost:5432/hexa_learn?schema=public

# MinIO / S3
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_strong
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change_me_strong
S3_FORCE_PATH_STYLE=true
S3_BUCKET_VIDEOS=hexa-videos
S3_BUCKET_MEDIA=hexa-media
S3_BUCKET_SLIPS=hexa-slips
S3_BUCKET_BOOKS=hexa-books
BOOK_MAX_MB=50
# Browser-reachable endpoint for signed URLs (internal Docker endpoint differs)
S3_PUBLIC_URL=http://localhost:9000

FIREBASE_PROJECT_ID="example-project-id"
FIREBASE_WEB_API_KEY="your-firebase-web-api-key"
FIREBASE_CLIENT_EMAIL="example-client-email@example.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY----YOUR_PRIVATE"

# pgAdmin (optional tools profile)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me
ADMIN_NAME=Administrator
ADMIN_ROLE=super_admin

# Learning API infrastructure
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
