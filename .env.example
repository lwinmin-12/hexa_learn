# App
PORT=3000
NODE_ENV=production
JWT_SECRET=change_me

# Postgres
POSTGRES_USER=hexa
POSTGRES_PASSWORD=change_me_strong
POSTGRES_DB=hexa_learn

# Prisma (used when running prisma commands on your host machine)
DATABASE_URL=postgresql://hexa:change_me_strong@localhost:5432/hexa_learn?schema=public

# MinIO / S3
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_strong
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change_me_strong
S3_FORCE_PATH_STYLE=true
S3_BUCKET_VIDEOS=hexa-videos
S3_BUCKET_MEDIA=hexa-media
S3_BUCKET_SLIPS=hexa-slips
# Browser-reachable endpoint for signed URLs (internal Docker endpoint differs)
S3_PUBLIC_URL=http://localhost:9000

# Firebase Admin: path to a service account JSON on the API host (never commit it)
# Host-only option; for Docker use the inline credentials below.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
FIREBASE_PROJECT_ID=your-project-id
# Alternatively supply base64-encoded service account JSON:
# FIREBASE_SERVICE_ACCOUNT_BASE64=
# Or set both fields with FIREBASE_PROJECT_ID (private key supports escaped newlines):
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
FIREBASE_WEB_API_KEY=your-firebase-web-api-key

# Phone OTP uses Firebase: 5 minute expiry, 60 second resend cooldown, 5 attempts.

# pgAdmin (optional tools profile)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me

# Learning API infrastructure
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
